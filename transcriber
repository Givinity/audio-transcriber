#!/usr/bin/env bash
# Обёртка, чтобы не активировать venv вручную.
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
BIN="$HERE/.venv/bin/transcriber"

if [[ ! -x "$BIN" ]]; then
    echo "Проект ещё не установлен. Запустите:" >&2
    echo "  $HERE/install.sh" >&2
    exit 1
fi

exec "$BIN" "$@"